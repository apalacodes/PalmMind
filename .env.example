# if you use MongoDB Atlas, use the following URI format and replace <username>, <password>, and your-cluster with your actual credentials and cluster information.
MONGODB_URI=mongodb+srv://<username>:<password>@your-cluster.xxxx.mongodb.net/

# Qdrant Cloud
QDRANT_API_KEY=your-qdrant-api-key

# MongoDB (Docker local)
MONGODB_URI=mongodb://localhost:27017

# Redis (Docker local)
REDIS_URL=redis://localhost:6379

# Groq (free at console.groq.com)
GROQ_API_KEY=your-groq-api-key